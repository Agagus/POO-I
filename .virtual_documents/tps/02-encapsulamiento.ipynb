








class Estudiante :
    
    def __init__(self, nombre, nota):
        self.__nombre = nombre
        self.__nota = nota

    def imprime(self) :
        print(f"El/La estudiante {self.__nombre} obtuvo la nota {self.__nota}")
        if self.__nota < 4 and self.__nota > 0 :
            print("Desaprobado")
        elif self.__nota >= 4 and self.__nota <=10 :
            print("Aprobado")
        else: print("Nota inválida")

estudiante = Estudiante("Agustina", 1)
estudiante2 = Estudiante("Juan", 4)
estudiante3 = Estudiante("Pepe", 11)
estudiante.imprime()
estudiante2.imprime()
estudiante3.imprime()








class Persona :

    def __init__(self, nombre, edad):
        self.__nombre = nombre
        self.__edad = edad

    def cumpleaños(self):
        self.__edad = self.__edad + 1

    def imprime(self):
        print(self.__nombre, self.__edad)

maria = Persona("Maria", 30)
maria.cumpleaños()
maria.imprime()








class Calculadora:
    
    def __init__(self, valor1, valor2):
        self.__valor1 = valor1
        self.__valor2 = valor2

    def suma(self):
        print(self.__valor1 + self.__valor2)

    def resta(self):
        print(self.__valor1 - self.__valor2)

    def multiplicacion(self):
        print(self.__valor1 * self.__valor2)

    def division(self):
        print(self.__valor1 / self.__valor2)


calc = Calculadora(5,2)
calc.suma()
calc.resta()
calc.multiplicacion()
calc.division()









class Nota:
    def __init__(self, valorInicial = 0):
        if valorInicial >= 0 and valorInicial <=10:
            self.__valorInicial = valorInicial
        else :
            raise ValueError("La nota es inválida")

    def obtenerValor(self):
        return self.__valorInicial

    def aprobado(self):
        if self.__valorInicial >= 4:
            return True
        return False

    def desaprobado(self):
        if self.__valorInicial < 4:
            return True
        return False

    @property
    def valorInicial(self):
        return self.__valorInicial
    
    @valorInicial.setter
    def recuperar(self, nuevoValor):
        if nuevoValor > self.__valorInicial and nuevoValor <= 10:
            self.__valorInicial = nuevoValor
        else :
            raise ValueError("No supera la nota actual")

nota = Nota(4)
a = nota.obtenerValor()
b = nota.aprobado()
c = nota.desaprobado()
nota.recuperar = 6
a = nota.obtenerValor()
nota.recuperar = 10
print(nota.valorInicial, nota.desaprobado(), nota.aprobado())






























































































































class Producto :

    def __init__(self, codigo, descripcion, precio, stock):
        self.__codigo = codigo
        self.__descripcion = descripcion
        self.__precio = precio
        self.__stock = stock

    @property
    def precio(self):
        return self.__precio

    @precio.setter
    def precio(self, nuevo_precio):
        if nuevo_precio < 0:
            raise ValueError("El precio es inválido")
        self.__precio = nuevo_precio

    @property
    def stock(self):
        return self.__stock

    @stock.setter
    def stock(self, nuevo_stock):
        if nuevo_stock < 0:
            raise ValueError("El stock es inválido")
        self.__stock = nuevo_stock

    def aumentar_stock(self, cantidad) :
        self.__stock += cantidad

    def decrementar_stock(self, cantidad) :
        if cantidad > self.__stock:
            raise ValueError("Stock no suficiente")    
        self.__stock -= cantidad
    
    def __str__(self):
        return f"Producto {self.__codigo}, descripcion {self.__descripcion}, precio ${self.__precio}, stock {self.__stock}"

silla = Producto(1111, "silla", 10000, 5)
print(silla.__str__())
silla.precio = 5000
silla.aumentar_stock(10)
print(silla)
silla.decrementar_stock(5)
print(silla)









































































